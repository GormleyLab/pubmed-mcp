# Anthropic API Key (required)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-api-key-here

# ----- Scholar Gateway (Wiley) -----
# Enables access to Wiley's academic articles via Scholar Gateway.

# Preferred: custom connector using the OAuth2 client_credentials grant.
# Non-interactive machine-to-machine auth — no browser reauth required.
# These are secrets: keep them only here in .env (this file is git-ignored).
SCHOLAR_GATEWAY_CLIENT_ID=your-client-id-here
SCHOLAR_GATEWAY_CLIENT_SECRET=your-client-secret-here

# Legacy fallback: static OAuth token obtained manually via the MCP Inspector.
# Only used if the client_credentials pair above is not set. Tokens expire.
# Docs: https://docs.scholargateway.ai/
SCHOLAR_GATEWAY_TOKEN=your-token-here

# ----- Jiminy MCP Server on AWS App Runner API Key -----
# For connecting to the deployed App Runner service
PAPERRAG_API_KEY=your-paperrag-api-key-here