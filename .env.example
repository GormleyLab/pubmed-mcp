# Anthropic API Key (required)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-api-key-here

# ----- Scholar Gateway (Wiley) -----
# Enables access to Wiley's academic articles via Scholar Gateway.

# v2 custom connector: static API key sent as an X-API-Key header.
# This is a secret: keep it only in .env (git-ignored). Never commit it.
SCHOLAR_GATEWAY_API_KEY=your-api-key-here

# ----- Jiminy MCP Server on AWS App Runner API Key -----
# For connecting to the deployed App Runner service
PAPERRAG_API_KEY=your-paperrag-api-key-here